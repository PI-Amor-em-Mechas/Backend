# Senha do MySQL
DB_PASSWORD=root

# Chave global da Evolution API (usada para autenticar na API)
EVOLUTION_GLOBAL_API_KEY=minha-chave-global

# Nome da instância WhatsApp (será criada na Evolution)
EVOLUTION_INSTANCE=amor-em-mechas

# Token que protege o webhook (pode inventar qualquer valor)
EVOLUTION_WEBHOOK_TOKEN=meu-token-webhook
